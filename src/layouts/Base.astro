---
const {
  title,
  description = '',
  canonical = '',
  ogType = 'website',
  ogImage = '',
  jsonLd = null,
} = Astro.props;
const siteName = '郵風快訊';
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=VT323&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>
<body>
  <slot />
  <footer class="footer">
    <div class="footer-social">
      <a href="https://www.facebook.com/KaohsiungPost" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer-social-icon"><i class="fa-brands fa-facebook"></i></a>
      <a href="https://www.threads.com/@kspost08?hl=zh-tw" target="_blank" rel="noopener noreferrer" aria-label="Threads" class="footer-social-icon"><i class="fa-brands fa-threads"></i></a>
      <a href="https://www.instagram.com/kspost08/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-icon"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://lin.ee/Uzyii0z" target="_blank" rel="noopener noreferrer" aria-label="LINE 官方帳號" class="footer-social-icon"><i class="fa-brands fa-line"></i></a>
    </div>
    <p class="footer-note">本站由 高雄郵局企劃行銷科 維護管理，提供郵局商品在高雄地區郵局販售的庫存查詢，方便消費者可以前往購買。</p>
    <p class="footer-note"><a href={import.meta.env.BASE_URL + 'kh-limited/'} style="color:var(--sd-wood-dark); font-weight:bold;">⭐ 看看高雄郵局限定小物牆</a></p>
    © Design by Chiahsien
  </footer>

  <style is:global>
    :root{
      --sd-grass:#88c24c; --sd-grass-dark:#6fa03d; --sd-wood:#c06c28; --sd-wood-dark:#82380d;
      --sd-parchment:#fdeca6; --sd-parchment-dark:#dcb360; --sd-border:#4a2100;
      --sd-text:#41220b; --sd-text-muted:#734e2c;
    }
    *{ box-sizing:border-box; }
    body{
      font-family:'Noto Sans TC','Microsoft JhengHei',sans-serif; background-color:var(--sd-grass);
      background-image:linear-gradient(var(--sd-grass-dark) 1px,transparent 1px),linear-gradient(90deg,var(--sd-grass-dark) 1px,transparent 1px);
      background-size:40px 40px; color:var(--sd-text); margin:0; line-height:1.8;
    }
    .header{
      background:linear-gradient(to bottom,#d6833b 0%,var(--sd-wood) 100%); color:#fff; padding:18px 20px;
      text-align:center; border-bottom:5px solid var(--sd-border); position:sticky; top:0; z-index:100;
      box-shadow:0 6px 0 rgba(0,0,0,.15); display:flex; justify-content:space-between; align-items:center;
    }
    .header .header-title{ margin:0; font-size:18px; font-weight:bold; color:#fff; text-shadow:2px 2px 0 var(--sd-border); flex-grow:1; }
    .btn-back{
      background:var(--sd-parchment); color:var(--sd-wood-dark); border:3px solid var(--sd-border);
      padding:6px 12px; border-radius:6px; font-weight:bold; text-decoration:none; font-size:14px;
      box-shadow:inset -2px -2px 0 rgba(0,0,0,.1);
    }
    .btn-back:hover{ background:#fff; }
    .container{ max-width:1000px; margin:30px auto; padding:0 15px; }
    .footer{ text-align:center; padding:30px 20px; color:var(--sd-text); font-weight:bold; font-size:15px; text-shadow:1px 1px 0 rgba(255,255,255,.5); letter-spacing:1px; }
    .footer-social{ display:flex; justify-content:center; gap:16px; margin-bottom:14px; }
    .footer-social-icon{
      width:42px; height:42px; display:flex; align-items:center; justify-content:center;
      background:var(--sd-wood); color:#fff; border-radius:50%; font-size:20px;
      text-decoration:none; box-shadow:0 3px 0 rgba(0,0,0,.15); transition:transform .15s, background .15s;
    }
    .footer-social-icon:hover{ background:var(--sd-wood-dark); transform:translateY(-3px); }
    .footer-note{ max-width:760px; margin:0 auto 10px; font-size:13px; color:var(--sd-text-muted); font-weight:normal; letter-spacing:0; border-top:1px solid rgba(0,0,0,.1); padding-top:15px; }

    /* 列表頁 */
    .sd-ui-box{ background:var(--sd-parchment); border:4px solid var(--sd-border); border-radius:8px;
      box-shadow:inset 0 0 0 3px var(--sd-parchment-dark),0 8px 0 rgba(0,0,0,.1); padding:20px; margin-bottom:30px; text-align:center; }
    .sd-ui-box h1,.sd-ui-box h2{ margin-top:0; color:var(--sd-wood-dark); }
    .blog-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:24px; }
    .article-card{ background:#fff; border:4px solid var(--sd-border); border-radius:8px; overflow:hidden;
      display:flex; flex-direction:column; text-decoration:none; color:inherit; transition:transform .2s,box-shadow .2s; box-shadow:0 6px 0 rgba(0,0,0,.15); }
    .article-card:hover{ transform:translateY(-5px); box-shadow:0 12px 15px rgba(0,0,0,.2); }
    .a-cover{ width:100%; height:180px; background:#e2e8f0; border-bottom:4px solid var(--sd-border); object-fit:cover; }
    .a-info{ padding:15px; display:flex; flex-direction:column; flex-grow:1; }
    .article-card .a-title{ font-size:18px; font-weight:bold; color:var(--sd-text); margin:0 0 10px; line-height:1.4; }
    .a-excerpt{ font-size:14px; color:var(--sd-text-muted); line-height:1.6; margin-bottom:15px;
      display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
    .a-meta{ margin-top:auto; font-size:13px; font-weight:bold; color:#a3aeb1; border-top:2px dashed #cbd5e0; padding-top:10px; }

    /* 單篇文章 */
    .article-box{ background:#fff; border:4px solid var(--sd-border); border-radius:12px; box-shadow:0 8px 0 rgba(0,0,0,.15); overflow:hidden; max-width:800px; margin:0 auto; }
    .cover-img{ width:100%; max-height:400px; object-fit:cover; border-bottom:4px solid var(--sd-border); display:block; }
    .content-area{ padding:30px; }
    .post-title{ font-size:28px; font-weight:bold; margin:0 0 15px; color:var(--sd-wood-dark); line-height:1.4; border-bottom:2px dashed #cbd5e0; padding-bottom:15px; }
    .post-meta{ font-size:14px; color:#64748b; font-weight:bold; margin-bottom:25px; }
    .a-body{ font-size:17px; color:#334155; }
    .a-body p{ margin-bottom:1em; }
    .a-body h2,.a-body h3,.a-body h4{ color:var(--sd-wood-dark); line-height:1.4; margin:1.4em 0 .6em; font-weight:bold; }
    .a-body h2{ font-size:24px; border-bottom:2px dashed #cbd5e0; padding-bottom:8px; }
    .a-body h3{ font-size:20px; } .a-body h4{ font-size:18px; }
    .a-body ul,.a-body ol{ padding-left:1.6em; margin:0 0 1em; }
    .a-body li{ margin-bottom:.5em; }
    .a-body a{ color:var(--sd-wood); font-weight:bold; text-decoration:underline; }
    .a-body blockquote{ margin:1.2em 0; padding:12px 18px; background:var(--sd-parchment); border-left:5px solid var(--sd-wood); border-radius:6px; color:var(--sd-text); font-style:italic; }
    .a-body blockquote cite{ display:block; margin-top:8px; font-size:14px; color:#734e2c; font-style:normal; }
    .a-body figure{ margin:1.2em 0; text-align:center; }
    .a-body figure img{ max-width:100%; max-height:520px; width:auto; height:auto; margin:0 auto 8px; display:block; border-radius:8px; border:2px solid #cbd5e0; }
    .a-body figure.is-stretched img{ width:100%; max-height:none; }
    .a-body figure.has-pct img{ width:100%; max-width:100%; height:auto; max-height:none; }
    .a-body .ej-image-row{ display:flex; flex-wrap:wrap; gap:16px; margin:1.2em 0; align-items:flex-start; }
    .a-body .ej-image-row figure.ej-image{ margin:0; min-width:100px; }
    .a-body .ej-image-row figure.ej-image img{ width:100%; max-height:none; margin:0 0 8px; }
    @media (max-width:600px){
      .a-body .ej-image-row{ flex-direction:column; }
      .a-body .ej-image-row figure.ej-image{ flex:1 1 100% !important; width:100% !important; }
    }
    .a-body figcaption{ font-size:14px; color:#64748b; }
    .a-body hr{ border:none; border-top:3px dotted #cbd5e0; margin:2em 0; }
    .a-body table{ width:100%; border-collapse:collapse; margin:1.2em 0; font-size:15px; }
    .a-body table th,.a-body table td{ border:2px solid #cbd5e0; padding:10px 14px; text-align:left; }
    .a-body table thead th{ background:var(--sd-parchment); color:var(--sd-wood-dark); font-weight:bold; }
    .a-body table tbody tr:nth-child(even){ background:#faf8f0; }

    /* 麵包屑 */
    .breadcrumb{ font-size:14px; color:#fff; margin:0 0 16px; text-shadow:1px 1px 0 var(--sd-border); }
    .breadcrumb a{ color:#fff; font-weight:bold; text-decoration:none; }
    .breadcrumb a:hover{ text-decoration:underline; }
    .breadcrumb span{ color:#fdeca6; }

    /* 相關文章 */
    .related{ max-width:800px; margin:30px auto 0; }
    .related-title{ color:var(--sd-wood-dark); background:var(--sd-parchment); border:3px solid var(--sd-border); border-radius:8px; padding:10px 16px; font-size:18px; margin:0; box-shadow:0 4px 0 rgba(0,0,0,.15); }
    .related-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; margin-top:16px; }
    .related-card{ background:#fff; border:3px solid var(--sd-border); border-radius:8px; overflow:hidden; text-decoration:none; color:var(--sd-text); display:flex; flex-direction:column; box-shadow:0 4px 0 rgba(0,0,0,.15); transition:transform .15s; }
    .related-card:hover{ transform:translateY(-3px); }
    .related-card img{ width:100%; height:120px; object-fit:cover; border-bottom:3px solid var(--sd-border); }
    .related-card span{ padding:10px 12px; font-weight:bold; font-size:14px; line-height:1.4; }

    @media (max-width:600px){
      .header{ flex-direction:column; gap:10px; padding:15px; }
      .btn-back{ width:100%; text-align:center; }
      .blog-grid{ grid-template-columns:1fr; }
      .content-area{ padding:20px; } .post-title{ font-size:22px; } .a-body{ font-size:16px; }
    }
  </style>
</body>
</html>
