<!--
  高雄郵局 sitemap
  1. 請把所有 kspost08.tw 換成你的實際網域。
  2. 每篇文章可手動複製最下方 <url> 範例（改 id 與 lastmod）。
     階段二改用 Astro 後，此檔可自動產生並包含全部文章。
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://kspost08.tw/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://kspost08.tw/blog.html</loc>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- 文章範例（複製這段、改 id 與 lastmod）：
  <url>
    <loc>https://kspost08.tw/article.html?id=2</loc>
    <lastmod>2026-05-31</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  -->
</urlset>
